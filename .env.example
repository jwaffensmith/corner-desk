DATABASE_URL="postgresql://postgres:postgres@localhost:5434/cornerdesk"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5434/cornerdesk_test"
PORT=4000

# Sign-in. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The address the browser uses (the Vite dev server locally).
BETTER_AUTH_URL="http://localhost:5173"

# Set both values for each provider you want on the sign-in screen.
# Callback URL to register: <BETTER_AUTH_URL>/api/auth/callback/<google|github>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated emails allowed to sign in. Leave empty to let anyone sign up.
ALLOWED_EMAILS=
