generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Track {
  id                String       @id @default(cuid())
  slug              String       @unique
  name              String
  description       String?
  weeklyTargetMin   Int          @default(45)
  countsTowardStudy Boolean      @default(true)
  sortOrder         Int
  assignments       Assignment[]
}

model PrepSettings {
  id               Int @id @default(1)
  targetHours      Int @default(100)
  weeklyTargetMin  Int @default(180)
  weeklyStretchMin Int @default(240)
  assessmentEvery  Int @default(4)
}

model Week {
  id          String       @id @default(cuid())
  number      Int          @unique
  title       String?
  milestone   String?
  notes       String?
  completedAt DateTime?
  assignments Assignment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Assignment {
  id              String           @id @default(cuid())
  key             String           @unique
  week            Week             @relation(fields: [weekId], references: [id], onDelete: Cascade)
  weekId          String
  track           Track            @relation(fields: [trackId], references: [id], onDelete: Restrict)
  trackId         String
  title           String
  description     String?
  objectives      String[]
  estimatedMin    Int
  resources       Json             @default("[]")
  sortOrder       Int
  isSupplementary Boolean          @default(false)
  status          AssignmentStatus @default(TODO)
  completedAt     DateTime?
  actualMin       Int?
  confidence      Int?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([weekId, sortOrder])
}

enum AssignmentStatus {
  TODO
  DONE
  SKIPPED
}
