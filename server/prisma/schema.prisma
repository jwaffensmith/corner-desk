generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  tracks        Track[]
  weeks         Week[]
  settings      PrepSettings?
  networking    NetworkingSettings?
  events        NetworkingEvent[]
  todos         Todo[]
  projects      Project[]
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Track {
  id                String       @id @default(cuid())
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  slug              String
  name              String
  description       String?
  weeklyTargetMin   Int          @default(45)
  countsTowardStudy Boolean      @default(true)
  sortOrder         Int
  assignments       Assignment[]

  @@unique([userId, slug])
  @@unique([id, userId])
}

model PrepSettings {
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String @id
  targetHours      Int    @default(100)
  weeklyTargetMin  Int    @default(180)
  weeklyStretchMin Int    @default(240)
  assessmentEvery  Int    @default(4)
}

model Week {
  id          String       @id @default(cuid())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  number      Int
  title       String?
  milestone   String?
  notes       String?
  completedAt DateTime?
  assignments Assignment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, number])
  @@unique([id, userId])
}

model Assignment {
  id              String           @id @default(cuid())
  // userId is part of both foreign keys, so an assignment's week and track always
  // belong to the same user as the assignment.
  userId          String
  key             String
  week            Week             @relation(fields: [weekId, userId], references: [id, userId], onDelete: Cascade)
  weekId          String
  track           Track            @relation(fields: [trackId, userId], references: [id, userId], onDelete: Restrict)
  trackId         String
  title           String
  description     String?
  objectives      String[]
  estimatedMin    Int
  resources       Json             @default("[]")
  sortOrder       Int
  isSupplementary Boolean          @default(false)
  status          AssignmentStatus @default(TODO)
  completedAt     DateTime?
  actualMin       Int?
  confidence      Int?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, key])
  @@index([weekId, sortOrder])
}

enum AssignmentStatus {
  TODO
  DONE
  SKIPPED
}

model NetworkingSettings {
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String @id
  eventsPerMonth Int    @default(1)
}

model NetworkingEvent {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  date      DateTime    @db.Date
  location  String?
  url       String?
  notes     String?
  status    EventStatus @default(REGISTERED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId, date])
}

enum EventStatus {
  REGISTERED
  ATTENDED
  SKIPPED
}

model Todo {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  // userId is part of the foreign key, so a to-do's project always belongs to the same user.
  project       Project?  @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  projectId     String?
  title         String
  notes         String?
  category      String?
  dueDate       DateTime? @db.Date
  repeatsWeekly Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, completedAt])
  @@index([projectId])
}

model Project {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  liveUrl   String?
  repoUrl   String?
  notes     String?
  todos     Todo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, userId])
  @@index([userId])
}
